{
  "name": "@joka-7/modeldispatcher-react-ui",
  "version": "0.1.0",
  "description": "One React model/agent picker component for every app: provider + model select, BYOK key input, the no-key 'try it elsewhere' escape hatch, and a beginner's link — so the AI settings screen looks the same everywhere instead of each app hand-rolling its own.",
  "license": "MIT",
  "type": "module",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/styles.css dist/styles.css",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "llm",
    "ai-agent",
    "react",
    "ui",
    "model-picker",
    "gemini",
    "openai",
    "anthropic",
    "groq",
    "ollama"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@joka-7/modeldispatcher-browser-agent": "^0.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^25.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
