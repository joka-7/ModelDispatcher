{
  "name": "modeldispatcher-react-ui",
  "version": "0.6.5",
  "description": "Two React components for every app's AI settings: ModelPicker (a pure settings screen — add multiple providers, each with a model picked from a list and pooled API keys, plus saving a favorite free AI app; never navigates) and AskExternallyButton (opens the saved favorite, meant to live next to the prompt box) — so the AI settings screen looks the same everywhere instead of each app hand-rolling its own.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joka-7/ModelDispatcher.git",
    "directory": "clients/react-ui"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/styles.css dist/styles.css",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "llm",
    "ai-agent",
    "react",
    "ui",
    "model-picker",
    "gemini",
    "openai",
    "anthropic",
    "groq",
    "ollama"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "modeldispatcher-browser-agent": "^0.6.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^25.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
