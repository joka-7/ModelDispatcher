# --- Frontend (public; embedded in the browser bundle) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# reCAPTCHA v3 site key registered for App Check.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

# --- Backend (/api Python function) ---
# "enforce" (default) verifies App Check via firebase-admin; "disabled" bypasses
# it for local dev. Never set "disabled" in production.
MD_APP_CHECK_MODE=enforce
# Service-account credential for firebase-admin. Set exactly one:
#   - GOOGLE_APPLICATION_CREDENTIALS: a file path (local dev).
#   - FIREBASE_SERVICE_ACCOUNT_JSON: the JSON itself, raw or base64-encoded
#     (Vercel — no persistent filesystem to point a file path at).
# See FIREBASE_APPCHECK_SETUP.md for the full walkthrough.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Model providers (all optional) ---
# Leave a key unset to keep that tier on the keyless mock provider. Setting one
# upgrades exactly that tier to a live model — see api/_lib/wiring.py.
MD_OPENAI_API_KEY=
MD_OPENAI_MODEL=gpt-4o-mini
MD_ANTHROPIC_API_KEY=
MD_ANTHROPIC_MODEL=claude-opus-4-8
MD_GEMINI_API_KEY=
MD_GEMINI_MODEL=gemini-1.5-flash
