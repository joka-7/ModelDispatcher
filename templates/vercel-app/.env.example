# --- Frontend (public; embedded in the browser bundle) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# reCAPTCHA v3 site key registered for App Check.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

# --- Backend (/api Python function) ---
# "enforce" (default) verifies App Check via firebase-admin; "disabled" bypasses
# it for local dev. Never set "disabled" in production.
MD_APP_CHECK_MODE=enforce
# firebase-admin credential for token verification (path or JSON). See README.
GOOGLE_APPLICATION_CREDENTIALS=
